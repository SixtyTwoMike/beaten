# Copy to fastlane/.env (gitignored). Same App Store Connect API key as éist
# works: it's per team, not per app. The .p8 stays in
# ~/.appstoreconnect/private_keys/ and is never committed.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# App Review contact + demo login (fastlane metadata); fastlane/set-review-info.sh
# asks for each one. The demo account is a
# real beaten.games account: ./deploy/admin.sh create <email> makes one.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_PHONE=
REVIEW_EMAIL=
REVIEW_DEMO_USER=
REVIEW_DEMO_PASSWORD=

# Beaten — iOS build/upload automation (modelled on éist's).
#
# Auth uses the App Store Connect API key from fastlane/.env (see .env.example).
# Needs the App ID games.beaten.app and an App Store Connect app record first.
#
#   fastlane beta                    → build + upload to TestFlight
#   fastlane distribute group:"…"    → give the latest processed build to an external group
#   fastlane testers                 → add yourself (or email:"…") to internal TestFlight testing
#   fastlane builds                  → recent TestFlight builds
#   fastlane metadata                → upload the listing (no submit); screenshots:true for screenshots too
#   fastlane submit build:"N"        → submit an uploaded build for App Store review

default_platform(:ios)

API_KEY_ID    = ENV.fetch("ASC_KEY_ID")
API_ISSUER_ID = ENV.fetch("ASC_ISSUER_ID")
API_KEY_PATH  = File.expand_path(ENV.fetch("ASC_KEY_PATH"))

BUNDLE_ID = "games.beaten.app"
PROJECT   = "Beaten.xcodeproj"
SCHEME    = "Beaten"

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      in_house: false
    )
  end

  def connect
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: API_KEY_ID, issuer_id: API_ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app for #{BUNDLE_ID} yet") unless app
    app
  end

  desc "Build and upload to TestFlight. Pass version:\"1.0.1\" to override MARKETING_VERSION."
  lane :beta do |options|
    # The .xcodeproj is generated from project.yml.
    sh("cd .. && xcodegen generate")
    build_number = latest_testflight_build_number(app_identifier: BUNDLE_ID, initial_build_number: 0) + 1
    version_args = options[:version] ? "MARKETING_VERSION=#{options[:version]} " : ""
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} #{version_args}-allowProvisioningUpdates",
      output_directory: "build",
      clean: true
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Give the latest processed build to an external TestFlight group (no rebuild)"
  lane :distribute do |options|
    app = connect
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, processing_states: "VALID", sort: "-uploadedDate", limit: 1).first
    UI.user_error!("No processed build yet") unless build
    group = app.get_beta_groups(filter: { name: options[:group] || "Friends" }).first
    UI.user_error!("TestFlight group not found") unless group
    build.add_beta_groups(beta_groups: [group])
    UI.success("Build #{build.version} (#{build.app_version}) → #{group.name} ✅")
  end

  desc "Add App Store Connect team members to the internal TestFlight group (every build, no Beta App Review). email:\"…\" (must be on the App Store Connect team)"
  lane :testers do |options|
    app = connect
    name = options[:group] || "Internal"
    group = app.get_beta_groups(filter: { name: name }).first ||
            app.create_beta_group(group_name: name, is_internal_group: true, has_access_to_all_builds: true,
                                   public_link_enabled: nil, public_link_limit: nil, public_link_limit_enabled: nil)
    # The API leaves the account holder's email blank, so it can't be looked
    # up; pass email: (testers from other apps, e.g. éist, are reused).
    emails = options[:email] ? [options[:email]] : Spaceship::ConnectAPI::User.all.select { |u| u.roles.include?("ACCOUNT_HOLDER") }.map(&:email).reject { |e| e.to_s.empty? }
    UI.user_error!("Pass email:\"your Apple ID email\"") if emails.empty?
    emails.each do |email|
      tester = Spaceship::ConnectAPI::BetaTester.find(email: email)
      if tester
        Spaceship::ConnectAPI.add_beta_tester_to_group(beta_group_id: group.id, beta_tester_ids: [tester.id])
      else
        Spaceship::ConnectAPI.post_beta_tester_assignment(beta_group_ids: [group.id], attributes: { email: email })
      end
      UI.success("#{email} added to '#{group.name}' ✅")
    end
  end

  desc "Recent TestFlight builds"
  lane :builds do
    app = connect
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10, includes: "buildBetaDetail,preReleaseVersion").each do |b|
      detail = b.build_beta_detail
      UI.message("#{b.app_version} (#{b.version}) — #{b.processing_state}, TestFlight internal: #{detail&.internal_build_state || '?'}, expired: #{b.expired}")
    end
  end

  desc "What App Store Connect has for the app: locale, names, version state"
  lane :appinfo do
    app = connect
    UI.message("primary locale #{app.primary_locale}, name #{app.name}, sku #{app.sku}")
    info = app.fetch_edit_app_info || app.fetch_live_app_info
    info&.get_app_info_localizations&.each { |l| UI.message("info #{l.locale}: #{l.name} / #{l.subtitle.inspect} / privacy #{l.privacy_policy_url.inspect}") }
    UI.message("categories #{info&.primary_category&.id.inspect} #{info&.secondary_category&.id.inspect}")
    version = app.get_edit_app_store_version
    UI.message("edit version #{version&.version_string} #{version&.app_store_state}, copyright #{version&.copyright.inspect}")
    version&.get_app_store_version_localizations&.each do |l|
      sets = l.get_app_screenshot_sets.map { |set| "#{set.screenshot_display_type} ×#{set.app_screenshots&.count || 0}" }
      UI.message("version #{l.locale}: description #{l.description.to_s.length} chars, screenshots #{sets.join(', ')}")
    end
  end

  desc "Upload the App Store listing (metadata, age rating, review details) without submitting; screenshots:true replaces the screenshots too"
  lane :metadata do |options|
    upload_to_app_store(
      app_identifier: BUNDLE_ID,
      app_version: options[:version] || "1.0.0",
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      skip_screenshots: !options[:screenshots],
      # Replacing deletes then recreates the set, which App Store Connect
      # sometimes refuses ("Screenshot Set Already Exists") after deleting.
      # Without it, already-uploaded files are skipped by checksum; delete
      # stale ones in App Store Connect by hand.
      overwrite_screenshots: false,
      app_review_information: review_information,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
    set_age_rating
  end

  desc "Set the age rating answers from fastlane/age_rating.json"
  lane :age_rating do
    set_age_rating
  end

  # Sent as-is rather than through deliver's app_rating_config_path, which
  # drops answers it doesn't know (App Store Connect keeps adding them, e.g.
  # socialMedia) and then fails because they're missing.
  def set_age_rating
    app = connect
    info = app.fetch_edit_app_info || app.fetch_live_app_info
    declaration = info.fetch_age_rating_declaration
    answers = JSON.parse(File.read(File.join(__dir__, "age_rating.json")))
    Spaceship::ConnectAPI.patch_age_rating_declaration(age_rating_declaration_id: declaration.id, attributes: answers)
    UI.success("Age rating answers set ✅")
  end

  # App Review's contact and demo login, from fastlane/.env (never committed).
  # App Store Connect rejects review details without the contact fields, so
  # they're left out until those are filled in.
  def review_information
    return nil if %w[REVIEW_FIRST_NAME REVIEW_LAST_NAME REVIEW_PHONE REVIEW_EMAIL].any? { |k| ENV[k].to_s.empty? }
    {
      first_name: ENV["REVIEW_FIRST_NAME"],
      last_name: ENV["REVIEW_LAST_NAME"],
      phone_number: ENV["REVIEW_PHONE"],
      email_address: ENV["REVIEW_EMAIL"],
      demo_user: ENV["REVIEW_DEMO_USER"],
      demo_password: ENV["REVIEW_DEMO_PASSWORD"],
      # App Review notes (purpose, how to use it, services, regions): fastlane/review_notes.txt
      notes: File.read(File.join(__dir__, "review_notes.txt")).strip,
    }.compact
  end

  desc "Submit an already-uploaded build for App Store review: build:\"N\" version:\"1.0.0\""
  desc "Attach a TestFlight build to the version being edited: build:\"9\""
  lane :review_build do |options|
    UI.user_error!("Pass build:\"N\"") unless options[:build]
    app = connect
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    build = app.get_builds(filter: { version: options[:build].to_s }, includes: "preReleaseVersion")
               .find { |b| b.pre_release_version&.version == version.version_string }
    UI.user_error!("No build #{options[:build]} for #{version.version_string}") unless build
    version.select_build(build_id: build.id)
    UI.success("#{version.version_string} now uses build #{build.version}")
  end

  desc "Attach a file (the App Review screen recording) to the version's review details: path:\"…\""
  lane :review_attach do |options|
    path = File.expand_path(options[:path].to_s)
    UI.user_error!("No file at #{path}") unless File.file?(path)
    app = connect
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    detail = version.fetch_app_store_review_detail
    detail.app_store_review_attachments.to_a.each do |old|
      UI.message("removing earlier attachment #{old.file_name}")
      old.delete!
    end
    Spaceship::ConnectAPI::AppStoreReviewAttachment.create(app_store_review_detail_id: detail.id, path: path)
    UI.success("Attached #{File.basename(path)} (#{(File.size(path) / 1_048_576.0).round(1)} MB)")
  end

  lane :submit do |options|
    UI.user_error!("Pass build:\"N\"") unless options[:build]
    upload_to_app_store(
      app_identifier: BUNDLE_ID,
      build_number: options[:build].to_s,
      app_version: options[:version],
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
        # Game details and artwork come from IGDB, under its API terms.
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      }
    )
  end
end

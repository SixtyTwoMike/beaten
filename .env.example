# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# IGDB access goes through Twitch. Create a (free) application at
# https://dev.twitch.tv/console/apps and paste its credentials here.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Set to "1" to skip IGDB and use the built-in sample game catalog instead
# (useful for trying the app without credentials).
IGDB_MOCK="1"

# Optional: enables "Continue with Google" on the login/register pages.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

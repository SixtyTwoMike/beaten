# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# IGDB access goes through Twitch. Create a (free) application at
# https://dev.twitch.tv/console/apps and paste its credentials here.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Set to "1" to skip IGDB and use the built-in sample game catalog instead
# (useful for trying the app without credentials).
IGDB_MOCK="1"

# Optional: enables "Continue with Google" on the login/register pages.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (password resets, verification) via resend.com.
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=""

# RetroAchievements import (Settings > RetroAchievements). A site-wide Web API
# key from retroachievements.org > Settings > Keys; it is only read on the
# server. Leave empty and set RA_MOCK="1"

# Steam import (Settings > Steam). A site-wide Web API key from
# https://steamcommunity.com/dev/apikey (domain: the site's domain); only read
# on the server. Leave empty and set STEAM_MOCK="1" to use a sample library
# (and skip the trip to Steam's sign-in page).
STEAM_API_KEY=""
STEAM_MOCK="1" to use a built-in sample library.
RA_API_KEY=""
RA_MOCK="1"

generator client {
  provider      = "prisma-client-js"
  // Bundles are built on macOS but run on Ubuntu 24.04 (OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // Public handle for /<username>; lowercase a-z, 0-9, _ (null until chosen)
  username     String?   @unique
  // Username chosen at sign-up, claimed only once the email is confirmed, so
  // unconfirmed sign-ups can't squat names or reveal which emails exist.
  pendingUsername String?
  // Last time the username was changed (null: never, so the first change is
  // free). Changes are limited to one per USERNAME_CHANGE_DAYS.
  usernameChangedAt DateTime?
  name         String?
  passwordHash String?
  image        String?
  // Bumped by "sign out everywhere"; sessions carrying an older value are rejected.
  tokenVersion Int       @default(0)
  // Null until the address is confirmed (verification link, password reset,
  // or Google). Password accounts can't sign in until it's set.
  emailVerifiedAt DateTime?
  // Social handles shown on the public profile (normalised, no "@").
  instagram    String?
  bluesky      String?
  // Profile picture: a crop of a game the user has finished. Source is
  // "cover" or "artwork"; x/y are the focal point in % and zoom is 1–3.
  avatarGameId String?
  avatarGame   Game?     @relation(fields: [avatarGameId], references: [id], onDelete: SetNull)
  avatarSource String?
  avatarX      Float     @default(50)
  avatarY      Float     @default(50)
  avatarZoom   Float     @default(1)
  createdAt    DateTime  @default(now())
  playLogs     PlayLog[]
  shelves      Shelf[]
  authTokens   AuthToken[]
  raAccount    RaAccount?
  raAwards     RaAward[]
  chronicle    Chronicle?
}

// Single-use emailed tokens (password reset, email verification). Only a
// SHA-256 of the token is stored, so a database leak can't be replayed.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  // "RESET_PASSWORD" | "VERIFY_EMAIL"
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// Local cache of IGDB game data, populated when a game is first logged or shelved.
model Game {
  id          String      @id @default(cuid())
  igdbId      Int         @unique
  name        String
  slug        String?
  coverUrl    String?
  // Wide key art (IGDB artwork, falling back to a screenshot) for banners
  artworkUrl  String?
  releaseYear Int?
  summary     String?
  // JSON array of IGDB platform ids, e.g. "[48,6,130]"
  platformIds String      @default("[]")
  createdAt   DateTime    @default(now())
  playLogs    PlayLog[]
  shelfItems  ShelfItem[]
  avatarOf    User[]
  chronicleGames ChronicleGame[]
}

// Synced from IGDB /platforms; drives platform dropdowns.
model Platform {
  id           Int     @id // IGDB platform id
  name         String
  abbreviation String?
  generation   Int?
  category     Int?
  // IGDB platform logo; Console Chronicles falls back to it when there's no
  // photo of the console (public/consoles).
  logoImageId  String?
}

model PlayLog {
  id         String    @id @default(cuid())
  userId     String
  gameId     String
  // "PLAYING" | "BEATEN" | "MASTERED" | "SHELVED" (SQLite has no enums;
  // validated in app code)
  status     String
  platformId Int?
  startedAt  DateTime?
  // How much of startedAt / stoppedAt was given: "DAY" (null), "MONTH" or
  // "YEAR". The date is then the first day of that month or year.
  startedPrecision String?
  // null while a game is still being played (status PLAYING)
  finishedAt DateTime?
  // "MONTH" / "YEAR" when only that much of the finish date was given
  // (null: exact day). Yearly totals only need the year.
  finishedPrecision String?
  // SHELVED only: when it was put down (optional), and whether they've
  // decided they're not going back to it.
  stoppedAt    DateTime?
  stoppedPrecision String?
  notReturning Boolean   @default(false)
  isReplay   Boolean   @default(false)
  // 1-10 = half-star steps of a 5-star scale (7 = 3.5 stars)
  rating     Int?
  reviewText String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  raAwards   RaAward[]

  @@index([userId, finishedAt])
  @@index([userId, status])
}

model Shelf {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ShelfItem[]

  @@unique([userId, name])
}

model ShelfItem {
  id      String   @id @default(cuid())
  shelfId String
  gameId  String
  addedAt DateTime @default(now())
  shelf   Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([shelfId, gameId])
}

// A linked RetroAchievements account. Requests use the site-wide RA_API_KEY;
// nothing secret of the user's is stored, only their public RA identity.
model RaAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  // Display casing as RA returns it
  raUsername   String
  // RA's stable user id; usernames can be changed on RA
  raUlid       String?
  lastSyncedAt DateTime?
  // Any sync attempt (successful or not), for the per-user rate limit
  lastAttemptAt DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per RetroAchievements award that maps to a Beaten status, so syncs
// can tell what's new. A game can have a BEATEN and a MASTERED row; the
// import turns each game into a single diary entry with the highest status.
model RaAward {
  id          String    @id @default(cuid())
  userId      String
  raGameId    Int
  // "BEATEN" | "MASTERED" (RA mastery and softcore completion both master)
  kind        String
  awardedAt   DateTime
  title       String
  consoleId   Int?
  consoleName String?
  // RA's game icon path (e.g. /Images/012345.png on media.retroachievements.org)
  iconPath    String?
  // Earned in hardcore mode (no save states / rewind)
  hardcore    Boolean   @default(false)
  // "PENDING" (awaiting review) | "IMPORTED" (created or upgraded a log)
  // | "LINKED" (game was already in the diary) | "SKIPPED"
  state       String    @default("PENDING")
  // Proposed IGDB match while pending; the accepted one afterwards
  igdbId      Int?
  // "HIGH" | "LOW" | "NONE"; null until the matcher has looked
  matchConfidence String?
  // What the proposed match looks like, for the review list (not every
  // matched game is in the local Game cache yet)
  matchName     String?
  matchCoverUrl String?
  matchYear     Int?
  playLogId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  playLog     PlayLog?  @relation(fields: [playLogId], references: [id], onDelete: SetNull)

  @@unique([userId, raGameId, kind])
  @@index([userId, state])
}

// Usernames nobody can take without an invite: names set aside for someone
// (`beaten-admin reserve`), and a user's previous username, held for them
// for a while after they change it.
model ReservedUsername {
  username      String    @id
  note          String?
  // sha256 of the invite code; whoever has the code may take the name.
  inviteHash    String?   @unique
  // A previous username, held for its old owner until expiresAt.
  heldForUserId String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

// Console Chronicles: the consoles someone has owned, in order, as a
// zig-zag timeline (Extras). One per user; public whenever the profile is.
model Chronicle {
  userId     String           @id
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  // Optional; only used to work out "age when I got it" for each console.
  birthYear  Int?
  showAges   Boolean          @default(true)
  // Look, from fixed choices (lib/chronicle.ts).
  accent     String           @default("mint")
  background String           @default("glow")
  path       String           @default("dotted")
  updatedAt  DateTime         @updatedAt
  entries    ChronicleEntry[]
}

model ChronicleEntry {
  id           String          @id @default(cuid())
  userId       String
  chronicle    Chronicle       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  platformId   Int // IGDB platform id
  // Free-text model ("Slim", "Lite", "Launch edition"), optional.
  model        String?
  // When they got it; at least the year. Precision as on PlayLog dates.
  gotAt        DateTime
  gotPrecision String?
  // Typed age, overriding the one worked out from the birth year.
  age          Int?
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  games        ChronicleGame[]

  @@index([userId, gotAt])
}

// Up to three favourite games per console, in order.
model ChronicleGame {
  entryId  String
  entry    ChronicleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position Int // 1-3
  gameId   String
  game     Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([entryId, position])
}

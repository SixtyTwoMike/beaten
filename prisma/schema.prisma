generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  image        String?
  createdAt    DateTime  @default(now())
  playLogs     PlayLog[]
  shelves      Shelf[]
}

// Local cache of IGDB game data, populated when a game is first logged or shelved.
model Game {
  id          String      @id @default(cuid())
  igdbId      Int         @unique
  name        String
  slug        String?
  coverUrl    String?
  releaseYear Int?
  summary     String?
  // JSON array of IGDB platform ids, e.g. "[48,6,130]"
  platformIds String      @default("[]")
  createdAt   DateTime    @default(now())
  playLogs    PlayLog[]
  shelfItems  ShelfItem[]
}

// Synced from IGDB /platforms; drives platform dropdowns.
model Platform {
  id           Int     @id // IGDB platform id
  name         String
  abbreviation String?
  generation   Int?
  category     Int?
}

model PlayLog {
  id         String    @id @default(cuid())
  userId     String
  gameId     String
  // "PLAYING" | "BEATEN" | "MASTERED" (SQLite has no enums; validated in app code)
  status     String
  platformId Int?
  startedAt  DateTime?
  // null while a game is still being played (status PLAYING)
  finishedAt DateTime?
  isReplay   Boolean   @default(false)
  // 1-10 = half-star steps of a 5-star scale (7 = 3.5 stars)
  rating     Int?
  reviewText String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, finishedAt])
  @@index([userId, status])
}

model Shelf {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ShelfItem[]

  @@unique([userId, name])
}

model ShelfItem {
  id      String   @id @default(cuid())
  shelfId String
  gameId  String
  addedAt DateTime @default(now())
  shelf   Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([shelfId, gameId])
}
